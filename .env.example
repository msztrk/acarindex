# ─────────────────────────────────────────────────────────────────────────────
# AcarIndex Web — Environment Variables
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# .env.local Git'e eklenmez (.gitignore'da).
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://beta.acarindex.com
NEXT_PUBLIC_CANONICAL_BASE=https://www.acarindex.com

# ── PostgreSQL (birincil uygulama veritabanı) ───────────────────────────────
# Standart bağlantı — Supabase, yerel veya kendi sunucu PostgreSQL ile uyumlu
DATABASE_URL=postgresql://acarindex:dev_password_change_me@127.0.0.1:5432/acarindex_dev?schema=public

# Uygulama okumaları için Prisma kullan (DATABASE_URL tanımlıysa varsayılan)
# Geçici Supabase DB fallback: USE_SUPABASE_DB=1

# ── Kaynak MySQL (ETL salt okunur) ───────────────────────────────────────────
SOURCE_DATABASE_URL=mysql://acarindex_etl_reader:YOUR_PASSWORD@127.0.0.1:3306/acarindex_source_local
# Alternatif parça parça:
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=acarindex_etl_reader
# MYSQL_PASSWORD=YOUR_PASSWORD
# MYSQL_DATABASE=acarindex_source_local

# Yerel SQL dump yolu (restore öncesi profil)
# USE_LOCAL_SOURCE=1
# LOCAL_SOURCE_SQL_PATH=D:\path\to\acarinde_yeniacarindex.sql

# ETL yazar registry (yazarlar tablosu yoksa zorunlu)
# AUTHOR_REGISTRY_MODE=provisional-only

# ── Supabase (geçici — yalnızca Auth pilot) ─────────────────────────────────
# Tam katalog aktarımı Supabase'e yapılmayacak
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Legacy — yerine DATABASE_URL kullanın
# SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres

# ── PDF (Faz-1: eski sunucudan serve) ────────────────────────────────────────
LEGACY_FILE_BASE_URL=https://www.acarindex.com

# ── Arama (Faz-3) ────────────────────────────────────────────────────────────
MEILISEARCH_HOST=
MEILISEARCH_ADMIN_KEY=
