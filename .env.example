# ─────────────────────────────────────────────────────────────────────────────
# AcarIndex Web — Environment Variables
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# .env.local Git'e eklenmez (.gitignore'da).
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ──────────────────────────────────────────────────────────────────────
# Beta aşamasında beta., cutover sonrası www.
NEXT_PUBLIC_SITE_URL=https://beta.acarindex.com

# Canonical base — cutover öncesi www., sonrası beta. ile aynı
NEXT_PUBLIC_CANONICAL_BASE=https://www.acarindex.com

# ── Supabase ──────────────────────────────────────────────────────────────────
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — ETL scriptleri ve sunucu tarafı işlemler için
# ⚠ ASLA tarayıcıya / istemci koduna sızdırma
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Direct Postgres (migration scriptleri — Dashboard → Database → Connection string)
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ── PDF (Faz-1: eski sunucudan serve) ────────────────────────────────────────
# PDF proxy bu URL üzerinden dosya çeker
LEGACY_FILE_BASE_URL=https://www.acarindex.com

# ── MySQL (sadece ETL scriptleri — Next.js runtime'da kullanılmaz) ───────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=acarindex_user
MYSQL_PASSWORD=guclu_bir_sifre_buraya
MYSQL_DATABASE=acarinde_yeniacarindex

# ── Arama (Faz-3 — şimdilik boş bırakın) ─────────────────────────────────────
MEILISEARCH_HOST=
MEILISEARCH_ADMIN_KEY=
