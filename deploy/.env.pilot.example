# Pilot stack env — sunucuda /etc/acarindex/pilot.env (chmod 600, Git dışı)
# Gerçek değerleri sunucuda doldurun.

APP_ENV=staging
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://beta.acarindex.com
NEXT_PUBLIC_CANONICAL_BASE=https://www.acarindex.com

POSTGRES_USER=acarindex_pilot
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=acarindex_pilot

PILOT_POSTGRES_USER=acarindex_pilot
PILOT_POSTGRES_PASSWORD=CHANGE_ME
PILOT_POSTGRES_DB=acarindex_pilot

# migrate + app + etl hedef (postgres servis adı)
DATABASE_URL=postgresql://acarindex_pilot:CHANGE_ME@postgres:5432/acarindex_pilot
PILOT_DATABASE_URL=postgresql://acarindex_pilot:CHANGE_ME@postgres:5432/acarindex_pilot

USE_SUPABASE_DB=0
ENABLE_USER_AUTH=false
NEXT_PUBLIC_ENABLE_USER_AUTH=false
ENABLE_ADMIN_PANEL=false
NEXT_PUBLIC_ENABLE_ADMIN_PANEL=false
USE_PG_AUTH=0
LEGACY_FILE_BASE_URL=https://www.acarindex.com
AUTHOR_REGISTRY_MODE=provisional-only

# ETL reader oluşturulduktan sonra (mariadb servis adı)
PILOT_SOURCE_DATABASE_URL=mysql://acarindex_etl_reader:CHANGE_ME@mariadb:3306/acarindex_source_pilot
SOURCE_DATABASE_URL=mysql://acarindex_etl_reader:CHANGE_ME@mariadb:3306/acarindex_source_pilot
ALLOW_PILOT_DOCKER_SOURCE=1

# Faz 6C — hesap yaşam döngüsü (varsayılan kapalı)

# ENABLE_PUBLIC_REGISTRATION=0
# ENABLE_EMAIL_VERIFICATION=0
# ENABLE_PASSWORD_RESET=0

# Faz 6C-Beta B — Resend (runtime secret Git dışı)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=AcarIndex <no-reply@notify.acarindex.com>
# EMAIL_REPLY_TO=destek@acarindex.com
# APP_PUBLIC_URL=https://beta.acarindex.com
# RESEND_WEBHOOK_SECRET=

# Pilot ETL runtime (scripts/etl-pg/pilot-run.ts)
ETL_BATCH_SIZE=200
ETL_TRANSACTION_TIMEOUT_MS=120000
ETL_TRANSACTION_MAX_WAIT_MS=15000
