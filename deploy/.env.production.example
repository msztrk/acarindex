# Production environment — örnek (gerçek değerleri sunucuda doldurun; Git'e commit etmeyin)

NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://beta.acarindex.com
NEXT_PUBLIC_CANONICAL_BASE=https://www.acarindex.com

# Katalog okuma — standart PostgreSQL (Supabase katalog kapalı)
DATABASE_URL=postgresql://acarindex_app:CHANGE_ME@postgres:5432/acarindex?schema=public
USE_SUPABASE_DB=0
ENABLE_USER_AUTH=false
NEXT_PUBLIC_ENABLE_USER_AUTH=false
ENABLE_ADMIN_PANEL=false
NEXT_PUBLIC_ENABLE_ADMIN_PANEL=false
USE_PG_AUTH=0

POSTGRES_USER=acarindex
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=acarindex

LEGACY_FILE_BASE_URL=https://www.acarindex.com
AUTHOR_REGISTRY_MODE=provisional-only

# ETL aşamasında (sunucuda, salt okunur kaynak):
# SOURCE_DATABASE_URL=mysql://etl_reader:CHANGE_ME@source-host:3306/acarindex_source

# Geçici auth (opsiyonel, feature flag kapalı):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
