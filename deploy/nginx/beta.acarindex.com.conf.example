# Nginx reverse proxy — beta.acarindex.com örneği
# SSL: Certbot veya hosting panel üzerinden kurulacak (bu dosyada sertifika yolu örnek)

upstream acarindex_app {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    server_name beta.acarindex.com;

    # Certbot sonrası HTTPS yönlendirmesi
    # return 301 https://$host$request_uri;

    location / {
        proxy_pass http://acarindex_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

