# Beta production stack (/etc/acarindex/beta.env on acarindex-beta)
# Gerçek şifreleri ve API anahtarlarını Git'e commit etmeyin.

NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://beta.acarindex.com
NEXT_PUBLIC_CANONICAL_BASE=https://www.acarindex.com

# Preprod PG (cutover sonrası)
DATABASE_URL=postgresql://acarindex_app:CHANGE_ME@acarindex-etl-preprod-postgres:5432/acarindex_etl_preprod_20260708?schema=public
USE_SUPABASE_DB=0

# User auth (beta cutover 2026-07)
ENABLE_USER_AUTH=1
NEXT_PUBLIC_ENABLE_USER_AUTH=1
USE_PG_AUTH=1
ENABLE_ADMIN_PANEL=0
NEXT_PUBLIC_ENABLE_ADMIN_PANEL=0

# Auth lifecycle — Resend domain verified sonrası açıldı
ENABLE_PUBLIC_REGISTRATION=1
ENABLE_EMAIL_VERIFICATION=1
ENABLE_PASSWORD_RESET=1
ENABLE_CAPTCHA=0

EMAIL_PROVIDER=resend
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=noreply@acarindex.com
EMAIL_REPLY_TO=destek@acarindex.com
ACAR_RESEND_DOMAIN_VERIFIED=1
APP_PUBLIC_URL=https://beta.acarindex.com

# Prod cutover sonrası gerçek kullanıcı maili için test redirect KAPALI:
# ACAR_BETA_MAIL_TEST_EMAIL=  (unset — tüm mailler gerçek adrese gider)

LEGACY_FILE_BASE_URL=https://www.acarindex.com
AUTHOR_REGISTRY_MODE=provisional-only

# Compose: docker compose --env-file /etc/acarindex/beta.env \
#   -f /opt/acarindex/docker-compose.production.yml up -d app --no-deps
