# Production rehearsal — yerel prova (gerçek secret değildir)

NODE_ENV=production

# Yerel prova — beta veya canlı değil
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001
NEXT_PUBLIC_CANONICAL_BASE=https://www.acarindex.com

# Docker internal network (service adı: postgres)
DATABASE_URL=postgresql://acarindex_rehearsal:rehearsal_dev_password@postgres:5432/acarindex_rehearsal?schema=public

POSTGRES_USER=acarindex_rehearsal
POSTGRES_PASSWORD=rehearsal_dev_password
POSTGRES_DB=acarindex_rehearsal

USE_SUPABASE_DB=0
ENABLE_USER_AUTH=false
NEXT_PUBLIC_ENABLE_USER_AUTH=false

LEGACY_FILE_BASE_URL=https://www.acarindex.com
AUTHOR_REGISTRY_MODE=provisional-only

# Katalog okuma Supabase gerektirmez — aşağıdakiler tanımsız bırakılır:
# NEXT_PUBLIC_SUPABASE_URL
# NEXT_PUBLIC_SUPABASE_ANON_KEY
# SUPABASE_URL
# SOURCE_DATABASE_URL (ETL aşamasında sunucuda)
