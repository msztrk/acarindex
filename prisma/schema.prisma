// Prisma schema — AcarIndex katalog (standart PostgreSQL)
// Supabase migration'larından konsolide baseline ile uyumlu.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        BigInt   @id
  legacyId  BigInt?  @unique @map("legacy_id")
  nameTr    String?  @map("name_tr")
  nameEn    String?  @map("name_en")
  slug      String?
  slugTr    String?  @map("slug_tr")
  slugEn    String?  @map("slug_en")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  journals Journal[]

  @@map("categories")
}

model Journal {
  id                BigInt   @id @default(dbgenerated("nextval('journals_id_seq'::regclass)"))
  legacyId          BigInt?  @unique @map("legacy_id")
  slug              String
  slugTr            String?  @map("slug_tr")
  slugEn            String?  @map("slug_en")
  hasEnContent      Boolean  @default(false) @map("has_en_content")
  titleTr           String?  @map("title_tr")
  titleEn           String?  @map("title_en")
  oldName           String?  @map("old_name")
  issn              String?
  eissn             String?
  publisher         String?
  frequency         String?
  startYear         String?  @map("start_year")
  publicationFormat String?  @map("publication_format")
  publishLanguage   String?  @map("publish_language")
  subjectCategory   String?  @map("subject_category")
  topics            String?
  editorInChief     String?  @map("editor_in_chief")
  editorialBoard    String?  @map("editorial_board")
  colophon          String?
  description       String?
  about             String?
  aimAndScope       String?  @map("aim_and_scope")
  policy            String?
  writingRules      String?  @map("writing_rules")
  pricePolicy       String?  @map("price_policy")
  indexesText       String?  @map("indexes_text")
  yearsIndexed      String?  @map("years_indexed")
  contactText       String?  @map("contact_text")
  contactJson       Json?    @map("contact_json")
  coverPath         String?  @map("cover_path")
  legacyLink        String?  @map("legacy_link")
  categoryId        BigInt?  @map("category_id")
  status            String   @default("published")
  hitCount          Int      @default(0) @map("hit_count")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category               Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  issues                 Issue[]
  articles               Article[]
  followedBy             FollowedJournal[]
  memberships            JournalMembership[]
  membershipApplications MembershipApplication[]

  @@index([slug])
  @@index([status])
  @@map("journals")
}

model Issue {
  id               BigInt   @id
  legacyId         BigInt?  @unique @map("legacy_id")
  journalId        BigInt   @map("journal_id")
  year             Int?
  issueNumber      String?  @map("issue_number")
  volume           String?
  issueLabel       String?  @map("issue_label")
  dergiparkIssueId BigInt?  @map("dergipark_issue_id")
  status           String   @default("published")
  hitCount         Int      @default(0) @map("hit_count")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  journal  Journal   @relation(fields: [journalId], references: [id], onDelete: Cascade)
  articles Article[]

  @@index([journalId, year(sort: Desc)])
  @@map("issues")
}

model Article {
  id                  BigInt    @id
  legacyId            BigInt?   @unique @map("legacy_id")
  slug                String
  slugTr              String?   @map("slug_tr")
  slugEn              String?   @map("slug_en")
  hasEnContent        Boolean   @default(false) @map("has_en_content")
  legacyJournalSlug   String    @map("legacy_journal_slug")
  legacyJournalSlugEn String?   @map("legacy_journal_slug_en")
  journalId           BigInt    @map("journal_id")
  issueId             BigInt?   @map("issue_id")
  titleTr             String?   @map("title_tr")
  titleEn             String?   @map("title_en")
  authorsRaw          String?   @map("authors_raw")
  authorsCitation     String?   @map("authors_citation")
  legacyAuthorIds     String?   @map("legacy_author_ids")
  institutionRaw      String?   @map("institution_raw")
  abstractTr          String?   @map("abstract_tr")
  abstractEn          String?   @map("abstract_en")
  keywordsTr          String?   @map("keywords_tr")
  keywordsEn          String?   @map("keywords_en")
  referencesRaw       String?   @map("references_raw")
  citationFormat      String?   @map("citation_format")
  pageStart           Int?      @map("page_start")
  pageEnd             Int?      @map("page_end")
  publishedAt         DateTime? @map("published_at") @db.Date
  publishedYear       Int?      @map("published_year")
  submissionDates     String?   @map("submission_dates")
  language            String?
  documentLanguage    String?   @map("document_language")
  documentType        String?   @map("document_type")
  articleType         String?   @map("article_type")
  accessType          String?   @default("open") @map("access_type")
  section             String?
  subjectArea         String?   @map("subject_area")
  doi                 String?
  dergiparkIssueId    BigInt?   @map("dergipark_issue_id")
  hitCount            Int       @default(0) @map("hit_count")
  downloadCount       Int       @default(0) @map("download_count")
  status              String    @default("published")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  journal        Journal           @relation(fields: [journalId], references: [id], onDelete: Restrict)
  issue          Issue?            @relation(fields: [issueId], references: [id], onDelete: SetNull)
  pdfFile        PdfFile?
  articleAuthors ArticleAuthor[]
  savedBy        SavedArticle[]
  listItems      ReadingListItem[]

  @@index([journalId, publishedYear(sort: Desc)])
  @@index([issueId])
  @@index([legacyJournalSlug, slug, id])
  @@index([status])
  @@map("articles")
}

model PdfFile {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  articleId      BigInt   @unique @map("article_id")
  legacyPdfPath  String?  @map("legacy_pdf_path")
  storageKey     String?  @map("storage_key")
  cdnUrl         String?  @map("cdn_url")
  fileSizeBytes  BigInt?  @map("file_size_bytes")
  pageCount      Int?     @map("page_count")
  checksumSha256 String?  @map("checksum_sha256")
  fileStatus     String   @default("legacy") @map("file_status")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([fileStatus])
  @@map("pdf_files")
}

model Author {
  id            BigInt   @id @default(autoincrement())
  legacyId      BigInt?  @unique @map("legacy_id")
  slug          String?
  name          String
  title         String?
  institution   String?
  bio           String?
  orcid         String?  @unique
  email         String?
  isProvisional Boolean  @default(false) @map("is_provisional")
  sourceKey     String?  @unique @map("source_key")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  articleAuthors ArticleAuthor[]
  followedBy     FollowedAuthor[]

  @@index([isProvisional])
  @@map("authors")
}

model ArticleAuthor {
  articleId      BigInt  @map("article_id")
  authorId       BigInt  @map("author_id")
  authorPosition Int?    @map("author_position")
  rawAuthorName  String? @map("raw_author_name")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  Author  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([articleId, authorId])
  @@index([authorId])
  @@map("article_authors")
}

model EtlRun {
  id           BigInt    @id @default(autoincrement())
  runId        String    @unique @map("run_id")
  script       String
  mode         String    @default("full")
  sourceTable  String?   @map("source_table")
  targetTable  String?   @map("target_table")
  limitRows    Int?      @map("limit_rows")
  offsetRows   Int       @default(0) @map("offset_rows")
  rowsRead     Int       @default(0) @map("rows_read")
  rowsInserted Int       @default(0) @map("rows_inserted")
  rowsUpdated  Int       @default(0) @map("rows_updated")
  rowsSkipped  Int       @default(0) @map("rows_skipped")
  rowsError    Int       @default(0) @map("rows_error")
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)
  status       String    @default("running")
  errorSummary String?   @map("error_summary")
  notes        String?

  errors EtlError[]

  @@index([script, startedAt(sort: Desc)])
  @@map("etl_runs")
}

model EtlError {
  id           BigInt   @id @default(autoincrement())
  runId        String   @map("run_id")
  sourceTable  String?  @map("source_table")
  sourceId     BigInt?  @map("source_id")
  sourceRow    Json?    @map("source_row")
  errorType    String   @map("error_type")
  errorMessage String   @map("error_message")
  fieldName    String?  @map("field_name")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  run EtlRun @relation(fields: [runId], references: [runId], onDelete: Cascade)

  @@index([runId])
  @@map("etl_errors")
}

model UrlAlias {
  legacyPath    String   @id @map("legacy_path")
  canonicalPath String   @map("canonical_path")
  entityType    String?  @map("entity_type")
  entityId      BigInt?  @map("entity_id")
  httpStatus    Int      @default(200) @map("http_status")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@map("url_aliases")
}

// ─── RBAC: dergi / kurum üyelikleri ve admin permissions (Faz 1–2) ───

enum MembershipStatus {
  pending
  approved
  rejected
  suspended
  revoked

  @@map("membership_status")
}

enum JournalMembershipRole {
  journal_owner
  journal_editor

  @@map("journal_membership_role")
}

enum InstitutionMembershipRole {
  institution_manager
  institution_viewer

  @@map("institution_membership_role")
}

enum MembershipApplicationType {
  journal_editor
  institution_manager

  @@map("membership_application_type")
}

enum ApplicationStatus {
  pending
  approved
  rejected
  cancelled

  @@map("application_status")
}

enum ChangeRequestStatus {
  pending
  approved
  rejected
  cancelled

  @@map("change_request_status")
}

model JournalMembership {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  journalId   BigInt                @map("journal_id")
  role        JournalMembershipRole
  status      MembershipStatus      @default(pending)
  invitedBy   String?               @map("invited_by") @db.Uuid
  approvedBy  String?               @map("approved_by") @db.Uuid
  approvedAt  DateTime?             @map("approved_at") @db.Timestamptz(6)
  suspendedAt DateTime?             @map("suspended_at") @db.Timestamptz(6)
  revokedAt   DateTime?             @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@unique([userId, journalId])
  @@index([journalId, status])
  @@index([userId, status])
  @@map("journal_memberships")
}

model Institution {
  id          BigInt    @id @default(autoincrement())
  slug        String    @unique
  nameTr      String    @map("name_tr")
  nameEn      String?   @map("name_en")
  emailDomain String?   @map("email_domain")
  website     String?
  logoUrl     String?   @map("logo_url")
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships  InstitutionMembership[]
  applications MembershipApplication[]

  @@index([isActive])
  @@map("institutions")
}

model InstitutionMembership {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String                    @map("user_id") @db.Uuid
  institutionId BigInt                    @map("institution_id")
  role          InstitutionMembershipRole
  status        MembershipStatus          @default(pending)
  invitedBy     String?                   @map("invited_by") @db.Uuid
  approvedBy    String?                   @map("approved_by") @db.Uuid
  approvedAt    DateTime?                 @map("approved_at") @db.Timestamptz(6)
  suspendedAt   DateTime?                 @map("suspended_at") @db.Timestamptz(6)
  revokedAt     DateTime?                 @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([userId, institutionId])
  @@index([institutionId, status])
  @@index([userId, status])
  @@map("institution_memberships")
}

model AdminPermission {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  permission String
  grantedBy  String?   @map("granted_by") @db.Uuid
  grantedAt  DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
  @@index([permission])
  @@map("admin_permissions")
}

model MembershipApplication {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          MembershipApplicationType
  userId        String                    @map("user_id") @db.Uuid
  journalId     BigInt?                   @map("journal_id")
  institutionId BigInt?                   @map("institution_id")
  payload       Json?
  status        ApplicationStatus         @default(pending)
  reviewedBy    String?                   @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?                 @map("reviewed_at") @db.Timestamptz(6)
  reviewNote    String?                   @map("review_note")
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  journal     Journal?     @relation(fields: [journalId], references: [id], onDelete: Cascade)
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([journalId, status])
  @@index([institutionId, status])
  @@map("membership_applications")
}

model ChangeRequest {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType  String              @map("entity_type")
  entityId    String              @map("entity_id")
  requestedBy String              @map("requested_by") @db.Uuid
  changeType  String              @map("change_type")
  oldData     Json?               @map("old_data")
  newData     Json?               @map("new_data")
  status      ChangeRequestStatus @default(pending)
  reviewedBy  String?             @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime?           @map("reviewed_at") @db.Timestamptz(6)
  reviewNote  String?             @map("review_note")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  requester User @relation("ChangeRequestRequester", fields: [requestedBy], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([requestedBy, status])
  @@index([status, createdAt(sort: Desc)])
  @@map("change_requests")
}

// ─── Kimlik doğrulama (PostgreSQL-native; bibliyografik Author ile birleştirilmez) ───

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique
  emailVerified DateTime? @map("email_verified") @db.Timestamptz(6)
  name          String?
  status        String    @default("active")
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  credential              UserCredential?
  sessions                Session[]
  roles                   UserRole[]
  auditLogs               AuditLog[]               @relation("AuditActor")
  authorClaims            AuthorClaim[]
  passwordResetTokens     PasswordResetToken[]
  verificationTokens      VerificationToken[]
  savedArticles           SavedArticle[]
  readingLists            ReadingList[]
  followedJournals        FollowedJournal[]
  followedAuthors         FollowedAuthor[]
  notificationPrefs       NotificationPreference?
  profile                 UserProfile?
  recentViews             RecentView[]
  legalAcceptances        UserLegalAcceptance[]
  accountDeletionRequests AccountDeletionRequest[]
  journalMemberships      JournalMembership[]
  institutionMemberships  InstitutionMembership[]
  adminPermissions        AdminPermission[]
  membershipApplications  MembershipApplication[]
  changeRequests          ChangeRequest[]          @relation("ChangeRequestRequester")
  contentApplications     ContentApplication[]     @relation("ContentApplicationOwner")
  assignedApplications    ContentApplication[]     @relation("ContentApplicationAssignee")
  applicationRevisions    ApplicationRevision[]    @relation("ApplicationRevisionCreator")
  applicationReviews      ApplicationReview[]      @relation("ApplicationReviewer")

  @@index([status])
  @@map("users")
}

model UserCredential {
  userId       String   @id @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  type      String    @default("email_verify")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Role {
  id          String  @id
  name        String  @unique
  description String?

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id")
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedBy String?  @map("granted_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  resource   String?
  resourceId String?  @map("resource_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  userAgent  String?  @map("user_agent")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model LoginAttempt {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String
  ipAddress String?  @map("ip_address")
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, createdAt(sort: Desc)])
  @@index([ipAddress, createdAt(sort: Desc)])
  @@map("login_attempts")
}

/// Faz 6B+ yazar sahiplenme — bu sprintte aktif özellik değil.
model AuthorClaim {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  authorId  BigInt   @map("author_id")
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, authorId])
  @@index([authorId])
  @@index([status])
  @@map("author_claims")
}

// ─── Kullanıcı paneli (Faz 6B) — bibliyografik Author ile birleştirilmez ───

model SavedArticle {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  articleId BigInt   @map("article_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("saved_articles")
}

model ReadingList {
