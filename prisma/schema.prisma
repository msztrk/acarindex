// Prisma schema — AcarIndex katalog (standart PostgreSQL)
// Supabase migration'larından konsolide baseline ile uyumlu.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        BigInt   @id
  legacyId  BigInt?  @unique @map("legacy_id")
  nameTr    String?  @map("name_tr")
  nameEn    String?  @map("name_en")
  slug      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  journals Journal[]

  @@map("categories")
}

model Journal {
  id                BigInt   @id
  legacyId          BigInt?  @unique @map("legacy_id")
  slug              String
  titleTr           String?  @map("title_tr")
  titleEn           String?  @map("title_en")
  oldName           String?  @map("old_name")
  issn              String?
  eissn             String?
  publisher         String?
  frequency         String?
  startYear         String?  @map("start_year")
  publicationFormat String?  @map("publication_format")
  publishLanguage   String?  @map("publish_language")
  subjectCategory   String?  @map("subject_category")
  topics            String?
  editorInChief     String?  @map("editor_in_chief")
  editorialBoard    String?  @map("editorial_board")
  colophon          String?
  description       String?
  about             String?
  aimAndScope       String?  @map("aim_and_scope")
  policy            String?
  writingRules      String?  @map("writing_rules")
  pricePolicy       String?  @map("price_policy")
  indexesText       String?  @map("indexes_text")
  yearsIndexed      String?  @map("years_indexed")
  contactText       String?  @map("contact_text")
  contactJson       Json?    @map("contact_json")
  coverPath         String?  @map("cover_path")
  legacyLink        String?  @map("legacy_link")
  categoryId        BigInt?  @map("category_id")
  status            String   @default("published")
  hitCount          Int      @default(0) @map("hit_count")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  issues   Issue[]
  articles Article[]
  followedBy FollowedJournal[]

  @@index([slug])
  @@index([status])
  @@map("journals")
}

model Issue {
  id               BigInt   @id
  legacyId         BigInt?  @unique @map("legacy_id")
  journalId        BigInt   @map("journal_id")
  year             Int?
  issueNumber      String?  @map("issue_number")
  volume           String?
  issueLabel       String?  @map("issue_label")
  dergiparkIssueId BigInt?  @map("dergipark_issue_id")
  status           String   @default("published")
  hitCount         Int      @default(0) @map("hit_count")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  journal  Journal   @relation(fields: [journalId], references: [id], onDelete: Cascade)
  articles Article[]

  @@index([journalId, year(sort: Desc)])
  @@map("issues")
}

model Article {
  id                BigInt    @id
  legacyId          BigInt?   @unique @map("legacy_id")
  slug              String
  legacyJournalSlug String    @map("legacy_journal_slug")
  journalId         BigInt    @map("journal_id")
  issueId           BigInt?   @map("issue_id")
  titleTr           String?   @map("title_tr")
  titleEn           String?   @map("title_en")
  authorsRaw        String?   @map("authors_raw")
  authorsCitation   String?   @map("authors_citation")
  legacyAuthorIds   String?   @map("legacy_author_ids")
  institutionRaw    String?   @map("institution_raw")
  abstractTr        String?   @map("abstract_tr")
  abstractEn        String?   @map("abstract_en")
  keywordsTr        String?   @map("keywords_tr")
  keywordsEn        String?   @map("keywords_en")
  referencesRaw     String?   @map("references_raw")
  citationFormat    String?   @map("citation_format")
  pageStart         Int?      @map("page_start")
  pageEnd           Int?      @map("page_end")
  publishedAt       DateTime? @map("published_at") @db.Date
  publishedYear     Int?      @map("published_year")
  submissionDates   String?   @map("submission_dates")
  language          String?
  documentLanguage  String?   @map("document_language")
  documentType      String?   @map("document_type")
  articleType       String?   @map("article_type")
  accessType        String?   @default("open") @map("access_type")
  section           String?
  subjectArea       String?   @map("subject_area")
  doi               String?
  dergiparkIssueId  BigInt?   @map("dergipark_issue_id")
  hitCount          Int       @default(0) @map("hit_count")
  downloadCount     Int       @default(0) @map("download_count")
  status            String    @default("published")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  journal        Journal         @relation(fields: [journalId], references: [id], onDelete: Restrict)
  issue          Issue?          @relation(fields: [issueId], references: [id], onDelete: SetNull)
  pdfFile        PdfFile?
  articleAuthors ArticleAuthor[]
  savedBy        SavedArticle[]
  listItems      ReadingListItem[]

  @@index([journalId, publishedYear(sort: Desc)])
  @@index([issueId])
  @@index([legacyJournalSlug, slug, id])
  @@index([status])
  @@map("articles")
}

model PdfFile {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  articleId      BigInt   @unique @map("article_id")
  legacyPdfPath  String?  @map("legacy_pdf_path")
  storageKey     String?  @map("storage_key")
  cdnUrl         String?  @map("cdn_url")
  fileSizeBytes  BigInt?  @map("file_size_bytes")
  pageCount      Int?     @map("page_count")
  checksumSha256 String?  @map("checksum_sha256")
  fileStatus     String   @default("legacy") @map("file_status")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([fileStatus])
  @@map("pdf_files")
}

model Author {
  id            BigInt   @id @default(autoincrement())
  legacyId      BigInt?  @unique @map("legacy_id")
  slug          String?
  name          String
  title         String?
  institution   String?
  bio           String?
  orcid         String?  @unique
  email         String?
  isProvisional Boolean  @default(false) @map("is_provisional")
  sourceKey     String?  @unique @map("source_key")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  articleAuthors ArticleAuthor[]
  followedBy     FollowedAuthor[]

  @@index([isProvisional])
  @@map("authors")
}

model ArticleAuthor {
  articleId      BigInt  @map("article_id")
  authorId       BigInt  @map("author_id")
  authorPosition Int?    @map("author_position")
  rawAuthorName  String? @map("raw_author_name")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  Author  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([articleId, authorId])
  @@index([authorId])
  @@map("article_authors")
}

model EtlRun {
  id           BigInt    @id @default(autoincrement())
  runId        String    @unique @map("run_id")
  script       String
  mode         String    @default("full")
  sourceTable  String?   @map("source_table")
  targetTable  String?   @map("target_table")
  limitRows    Int?      @map("limit_rows")
  offsetRows   Int       @default(0) @map("offset_rows")
  rowsRead     Int       @default(0) @map("rows_read")
  rowsInserted Int       @default(0) @map("rows_inserted")
  rowsUpdated  Int       @default(0) @map("rows_updated")
  rowsSkipped  Int       @default(0) @map("rows_skipped")
  rowsError    Int       @default(0) @map("rows_error")
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)
  status       String    @default("running")
  errorSummary String?   @map("error_summary")
  notes        String?

  errors EtlError[]

  @@index([script, startedAt(sort: Desc)])
  @@map("etl_runs")
}

model EtlError {
  id           BigInt   @id @default(autoincrement())
  runId        String   @map("run_id")
  sourceTable  String?  @map("source_table")
  sourceId     BigInt?  @map("source_id")
  sourceRow    Json?    @map("source_row")
  errorType    String   @map("error_type")
  errorMessage String   @map("error_message")
  fieldName    String?  @map("field_name")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  run EtlRun @relation(fields: [runId], references: [runId], onDelete: Cascade)

  @@index([runId])
  @@map("etl_errors")
}

model UrlAlias {
  legacyPath    String   @id @map("legacy_path")
  canonicalPath String   @map("canonical_path")
  entityType    String?  @map("entity_type")
  entityId      BigInt?  @map("entity_id")
  httpStatus    Int      @default(200) @map("http_status")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@map("url_aliases")
}

// ─── Kimlik doğrulama (PostgreSQL-native; bibliyografik Author ile birleştirilmez) ───

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique
  emailVerified DateTime? @map("email_verified") @db.Timestamptz(6)
  name          String?
  status        String    @default("active")
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  credential            UserCredential?
  sessions              Session[]
  roles                 UserRole[]
  auditLogs             AuditLog[]             @relation("AuditActor")
  authorClaims          AuthorClaim[]
  passwordResetTokens   PasswordResetToken[]
  verificationTokens    VerificationToken[]
  savedArticles         SavedArticle[]
  readingLists          ReadingList[]
  followedJournals      FollowedJournal[]
  followedAuthors       FollowedAuthor[]
  notificationPrefs     NotificationPreference?
  recentViews           RecentView[]
  legalAcceptances      UserLegalAcceptance[]
  accountDeletionRequests AccountDeletionRequest[]

  @@index([status])
  @@map("users")
}

model UserCredential {
  userId       String   @id @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  type      String   @default("email_verify")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Role {
  id          String @id
  name        String @unique
  description String?

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id")
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedBy String?  @map("granted_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  resource   String?
  resourceId String?  @map("resource_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model LoginAttempt {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String
  ipAddress String?  @map("ip_address")
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, createdAt(sort: Desc)])
  @@index([ipAddress, createdAt(sort: Desc)])
  @@map("login_attempts")
}

/// Faz 6B+ yazar sahiplenme — bu sprintte aktif özellik değil.
model AuthorClaim {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  authorId  BigInt   @map("author_id")
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, authorId])
  @@index([authorId])
  @@index([status])
  @@map("author_claims")
}

// ─── Kullanıcı paneli (Faz 6B) — bibliyografik Author ile birleştirilmez ───

model SavedArticle {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  articleId BigInt   @map("article_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("saved_articles")
}

model ReadingList {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ReadingListItem[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("reading_lists")
}

model ReadingListItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listId    String   @map("list_id") @db.Uuid
  articleId BigInt   @map("article_id")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  list    ReadingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  article Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([listId, articleId])
  @@index([listId, position])
  @@map("reading_list_items")
}

model FollowedJournal {
  userId    String   @map("user_id") @db.Uuid
  journalId BigInt @map("journal_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@id([userId, journalId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("followed_journals")
}

model FollowedAuthor {
  userId    String   @map("user_id") @db.Uuid
  authorId  BigInt   @map("author_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([userId, authorId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("followed_authors")
}

model NotificationPreference {
  userId                    String   @id @map("user_id") @db.Uuid
  followedJournalNewIssue   Boolean  @default(false) @map("followed_journal_new_issue")
  followedAuthorNewArticle  Boolean  @default(false) @map("followed_author_new_article")
  savedSearchAlert          Boolean  @default(false) @map("saved_search_alert")
  weeklyDigest              Boolean  @default(false) @map("weekly_digest")
  productAnnouncements      Boolean  @default(false) @map("product_announcements")
  updatedAt                 DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model RecentView {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   BigInt   @map("entity_id")
  viewedAt   DateTime @default(now()) @map("viewed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId, viewedAt(sort: Desc)])
  @@map("recent_views")
}

// ─── Hesap yaşam döngüsü (Faz 6C) ───

model LegalDocument {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        String
  version     String
  publishedAt DateTime @map("published_at") @db.Timestamptz(6)
  contentHash String   @map("content_hash")
  required    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  acceptances UserLegalAcceptance[]

  @@unique([type, version])
  @@index([type, publishedAt(sort: Desc)])
  @@map("legal_documents")
}

model UserLegalAcceptance {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  documentId      String   @map("document_id") @db.Uuid
  documentType    String   @map("document_type")
  documentVersion String   @map("document_version")
  documentHash    String   @map("document_hash")
  acceptedAt      DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  document LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([userId, documentId])
  @@index([userId, documentType])
  @@map("user_legal_acceptances")
}

model AccountDeletionRequest {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  status       String    @default("pending")
  requestedAt  DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  scheduledFor DateTime  @map("scheduled_for") @db.Timestamptz(6)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([scheduledFor])
  @@map("account_deletion_requests")
}

model AbuseEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType String   @map("event_type")
  key       String
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([eventType, key, createdAt(sort: Desc)])
  @@index([eventType, ipAddress, createdAt(sort: Desc)])
  @@map("abuse_events")
}

/// Site-wide düzenlenebilir metin ayarları (hero vb.)
model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("site_settings")
}
