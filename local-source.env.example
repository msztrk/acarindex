# Yerel kaynak SQL yedeği — .env.local içine ekleyin (commit ETMEYİN)
#
# SQL dosyası proje dışında veya local-backups altında tutulmalıdır.
# Örnek: D:\acarindex\acarinde_yeniacarindex.sql

USE_LOCAL_SOURCE=1
LOCAL_SOURCE_SQL_PATH=D:\acarindex\acarinde_yeniacarindex.sql
LOCAL_SOURCE_DB_NAME=acarindex_source_local

# Restore için admin (root) — yalnızca localhost
# SOURCE_MYSQL_ADMIN_URL=mysql://root:YOUR_ROOT_PASSWORD@127.0.0.1:3306/mysql

# ETL salt okunur kaynak
# SOURCE_MYSQL_URL=mysql://acarindex_etl_reader:YOUR_READER_PASSWORD@127.0.0.1:3306/acarindex_source_local

# mysql.exe yolu (Laragon örneği)
# LOCAL_MYSQL_BIN=C:\laragon\bin\mysql\mysql-8.4.3-winx64\bin\mysql.exe
