{
  "name": "acarindex-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:external": "vitest run --config vitest.external.config.ts",
    "test:watch": "vitest",
    "etl:authors": "npx tsx scripts/etl/04-authors.ts",
    "staging:verify-legacy-id": "npx tsx scripts/staging/verify-legacy-id.ts",
    "staging:snapshot": "npx tsx --env-file=.env.staging scripts/staging/snapshot.ts",
    "staging:seed": "npx tsx --env-file=.env.staging scripts/staging/seed-catalog.ts",
    "staging:migrate": "npx tsx --env-file=.env.staging scripts/staging/apply-migrations.ts",
    "staging:validate": "npx tsx --env-file=.env.staging scripts/staging/run-validation.ts",
    "staging:orphan-test": "npx tsx --env-file=.env.staging scripts/staging/test-orphan-scenario.ts",
    "source:inspect-dump": "npx tsx scripts/source/inspect-dump.ts",
    "source:restore": "npx tsx scripts/source/restore-local.ts",
    "source:inventory": "npx tsx scripts/source/inventory.ts",
    "source:etl-dry-run": "npx tsx scripts/source/etl-stage-dry-run.ts",
    "source:profile-authors": "npx tsx scripts/source/profile-author-columns.ts",
    "source:audit-secrets": "npx tsx scripts/audit-secrets.ts",
    "local:setup-env": "npx tsx scripts/local/setup-env-local.ts",
    "local:create-etl-reader": "npx tsx --env-file=.env.local scripts/local/create-etl-reader.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:schema-report": "npx tsx scripts/db/schema-report.ts",
    "etl:pilot-dry-run": "npx tsx scripts/etl-pg/pilot-dry-run.ts",
    "etl:pilot-run": "npx tsx scripts/etl-pg/pilot-run.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@prisma/client": "^6.19.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "mysql2": "^3.22.5",
    "pg": "^8.22.0",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
