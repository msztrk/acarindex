# ─────────────────────────────────────────────────────────────────────────────
# Staging Supabase — .env.staging olarak kopyalayın (commit ETMEYİN)
# Dashboard → Settings → API + Database connection string
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CANONICAL_BASE=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_URL=https://YOUR_STAGING_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key
SUPABASE_PROJECT_REF=YOUR_STAGING_REF

# Direct Postgres (migration scriptleri için)
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_STAGING_REF.supabase.co:5432/postgres

# Opsiyonel: production'dan seed (yalnızca katalog okuma)
# SOURCE_SUPABASE_URL=
# SOURCE_SUPABASE_SERVICE_ROLE_KEY=
